<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.aula.desafio_mobile.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/navigation_admin"
        android:name="com.aula.desafio_mobile.AdminFragment"
        android:label="Admin"
        tools:layout="@layout/fragment_admin" >
        <action
            android:id="@+id/action_navigation_admin_to_homeAdminFragment"
            app:destination="@id/navigation_home_admin" />
    </fragment>
    <fragment
        android:id="@+id/navigation_home_admin"
        android:name="com.aula.desafio_mobile.HomeAdminFragment"
        android:label="HomeAdmin"
        tools:layout="@layout/navigation_home_admin" />
</navigation>